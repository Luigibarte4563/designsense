    "designsense-tokens": ".claude-plugin/commands/designsense-tokens.js",
    "designsense-states": ".claude-plugin/commands/designsense-states.js",
    "designsense-style": ".claude-plugin/commands/designsense-style.js",
    "designsense-help": ".claude-plugin/commands/designsense-help.js"
  },
  "skills": [
