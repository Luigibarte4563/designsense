  "color": {
    "bg": "#FAFAFA",
    "surface": "#FFFFFF",
    "user": "#6366F1",
    "assistant": "#F3F4F6",
    "primary": "#6366F1",
    "secondary": "#EC4899",
    "accent": "#F59E0B",
    "ink": "#1F2937",
    "muted": "#6B7280",
    "border": "#E5E7EB",
    "focus": "#6366F1",
