{
  "name": "voice-ui",
  "border": {
    "width": "0px",
    "color": "transparent"
  },
  "shadow": {
    "default": "0 2px 8px rgba(0,0,0,0.06)",
    "hover": "0 4px 16px rgba(0,0,0,0.1)"
  },
  "radius": {
    "sm": "12px",
    "md": "18px",
    "lg": "24px",
