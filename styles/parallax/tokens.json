{
  "name": "parallax",
  "border": {
    "width": "0px",
    "color": "transparent"
  },
  "shadow": {
    "default": "0 8px 32px rgba(0,0,0,0.12)",
    "hover": "0 12px 40px rgba(0,0,0,0.16)"
  },
  "radius": {
    "sm": "8px",
    "md": "16px",
    "lg": "24px"
  },
  "color": {
    "bg": "#FAFAFA",
    "surface": "#FFFFFF",
    "primary": "#1E3A5F",
    "secondary": "#4A5568",
    "accent": "#ECC94B",
    "ink": "#1A202C",
    "muted": "#718096",
    "border": "#E2E8F0",
    "focus": "#3182CE",
    "error": "#E53E3E",
    "success": "#38A169",
    "white": "#FFFFFF",
    "layer1": "#FFFFFF",
    "layer2": "#F7FAFC",
    "layer3": "#EDF2F7",
    "layer4": "#E2E8F0"
  },
  "font": {
    "heading": "\"Playfair Display\", \"Georgia\", serif",
    "body": "\"Inter\", \"Source Serif Pro\", serif",
    "mono": "\"JetBrains Mono\", monospace",
    "weight": {
      "normal": 400,
      "medium": 500,
      "bold": 600
    }
  },
  "motion": {
    "duration": "600ms",
    "easing": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
    "parallaxSpeed": {
      "slow": "0.3",
      "medium": "0.5",
      "fast": "0.8"
    }
  },
  "a11yNotes": [
    "CRITICAL: prefers-reduced-motion disables parallax",
    "Focus: not affected by scroll position",
    "Provide non-parallax alternative",
    "Ensure content readable without scroll"
  ]
}