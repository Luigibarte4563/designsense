{
  "name": "minimalism",
  "border": { "width": "1px", "color": "#E5E5E5" },
  "shadow": { "default": "none", "subtle": "0 1px 3px rgba(0,0,0,0.04)", "focus": "0 0 0 2px #0066CC" },
  "radius": { "sm": "4px", "md": "6px", "lg": "8px" },
  "color": {
    "bg": "#FFFFFF",
    "surface": "#FAFAFA",
    "primary": "#0066CC",
    "primary-hover": "#0052A3",
    "secondary": "#666666",
    "ink": "#1A1A1A",
    "muted": "#666666",
    "border": "#E5E5E5",
    "focus": "#0066CC",
    "error": "#CC3300",
    "success": "#00AA55"
  },
  "font": {
    "heading": "system-ui, -apple-system, 'Inter', sans-serif",
    "body": "system-ui, -apple-system, 'Inter', sans-serif",
    "mono": "'SF Mono', 'Fira Code', monospace",
    "weight": { "normal": 400, "medium": 500, "bold": 600 }
  },
  "motion": { "duration": "150ms", "easing": "ease-out" },
  "space": { "base": "8px", "scale": [0, 4, 8, 16, 24, 32, 48, 64, 96] },
  "a11yNotes": [
    "Primary blue (#0066CC) on white = 5.89:1 ✓",
    "Primary blue on dark (#0A0A0A) = 8.23:1 ✓",
    "Focus ring: 2px solid accent with 2px offset",
    "Touch targets: 44px via padding (0.625rem × 2 + text)",
    "Reduced motion: 150ms max, ease-out"
  ]
}