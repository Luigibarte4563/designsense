{
  "name": "flat-design",
  "border": {
    "width": "0px",
    "color": "transparent"
  },
  "shadow": {
    "default": "none",
    "hover": "none",
    "active": "none"
  },
  "radius": {
    "sm": "0px",
    "md": "4px",
    "lg": "8px"
  },
  "color": {
    "bg": "#FFFFFF",
    "surface": "#F5F5F5",
    "primary": "#007AFF",
    "secondary": "#5856D6",
    "accent": "#FF2D55",
    "ink": "#1C1C1E",
    "muted": "#8E8E93",
    "border": "#C6C6C8",
    "focus": "#007AFF",
    "error": "#FF3B30",
    "success": "#34C759",
    "white": "#FFFFFF"
  },
  "font": {
    "heading": "-apple-system, BlinkMacSystemFont, \"SF Pro Display\", sans-serif",
    "body": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", sans-serif",
    "mono": "\"SF Mono\", monospace",
    "weight": {
      "normal": 400,
      "medium": 500,
      "bold": 600
    }
  },
  "motion": {
    "duration": "150ms",
    "easing": "ease-out"
  },
  "a11yNotes": [
    "High contrast by default — ensure 4.5:1 on all text",
    "Focus ring: 2px solid primary with 2px offset",
    "Touch targets: 44px via padding (no border contribution)"
  ]
}