  "color": {
    "bg": "#FFFFFF",
    "surface": "#FFFF00",
    "primary": "#FF0000",
    "secondary": "#0000FF",
    "accent": "#FFFF00",
    "ink": "#000000",
    "muted": "#666666",
    "border": "#000000",
    "focus": "#FF0000",
