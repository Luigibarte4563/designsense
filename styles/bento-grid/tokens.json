{
  "name": "bento-grid",
  "border": {
    "width": "1px",
    "color": "rgba(0,0,0,0.08)"
  },
  "shadow": {
    "default": "0 2px 8px rgba(0,0,0,0.06)",
    "hover": "0 8px 24px rgba(0,0,0,0.1)"
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px"
  },
  "color": {
    "bg": "#F8F9FA",
    "surface": "#FFFFFF",
    "primary": "#0066CC",
    "secondary": "#6C757D",
    "accent": "#FF6B35",
    "ink": "#212529",
    "muted": "#6C757D",
    "border": "rgba(0,0,0,0.08)",
    "focus": "#0066CC",
    "error": "#DC3545",
    "success": "#28A745",
    "white": "#FFFFFF",
    "tile1": "#FFF8F0",
    "tile2": "#F0F8FF",
    "tile3": "#F5F5F5"
  },
  "font": {
    "heading": "\"Inter\", \"SF Pro Display\", sans-serif",
    "body": "\"Inter\", \"SF Pro Text\", sans-serif",
    "mono": "\"SF Mono\", monospace",
    "weight": {
      "normal": 400,
      "medium": 500,
      "bold": 600
    }
  },
  "motion": {
    "duration": "200ms",
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
  },
  "grid": {
    "columns": 4,
    "gap": "16px",
    "tileRatio": "1:1"
  },
  "a11yNotes": [
    "Focus ring visible on tile boundaries",
    "Grid order = tab order",
    "Tiles: min 44px touch target",
    "Reduced motion: disable hover lift"
  ]
}