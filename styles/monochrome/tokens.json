{
  "name": "monochrome",
  "border": {
    "width": "1px",
    "color": "var(--color-border)"
  },
  "shadow": {
    "default": "0 2px 8px rgba(0,0,0,0.08)",
    "hover": "0 4px 16px rgba(0,0,0,0.12)"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px"
  },
  "color": {
    "bg": "#F0F4F8",
    "surface": "#FFFFFF",
    "primary": "#1E3A5F",
    "primaryLight": "#2C5282",
    "primaryLighter": "#3182CE",
    "primaryLightest": "#63B3ED",
    "primaryDark": "#1A365D",
    "primaryDarker": "#0F2A4A",
    "accent": "#FFFFFF",
    "ink": "#1E3A5F",
    "muted": "#4A5568",
    "border": "#CBD5E0",
    "focus": "#3182CE",
    "error": "#E53E3E",
    "success": "#38A169",
    "white": "#FFFFFF"
  },
  "font": {
    "heading": "\"Inter\", sans-serif",
    "body": "\"Inter\", sans-serif",
    "mono": "\"Fira Code\", monospace",
    "weight": {
      "normal": 400,
      "medium": 500,
      "bold": 600
    }
  },
  "motion": {
    "duration": "200ms",
    "easing": "ease-out"
  },
  "a11yNotes": [
    "Ensure 4.5:1 between adjacent tones",
    "Darkest on lightest = max contrast",
    "Focus ring: 3px solid primary with offset",
    "Test colorblind safety (blue base works well)"
  ]
}